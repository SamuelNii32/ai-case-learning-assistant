<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>casepilot-ingestionapi-auth0-development</UserSecretsId>
		<!--
			Keep repository-local build, test, frontend, and deployment outputs out of
			MSBuild's default item globs. Without this, the web project can copy the
			test output back into its own output (and vice versa), producing recursively
			nested bin folders that make project evaluation and `dotnet run` extremely slow.
		-->
		<RepositoryGeneratedFiles>bin\**;obj\**;artifacts\**;dist\**;uploads\**;publish\**;publish-clean\**;deploy-out\**;deploy-staging\**;output\**;tmp\**;zip-verify\**;node_modules\**;performance\results\**;IngestionApi.Tests\**;*.zip</RepositoryGeneratedFiles>
		<DefaultItemExcludes>$(DefaultItemExcludes);$(RepositoryGeneratedFiles)</DefaultItemExcludes>
		<BuildReactOnPublish Condition="'$(BuildReactOnPublish)' == ''">true</BuildReactOnPublish>
		<NpmCommand Condition="'$(NpmCommand)' == ''">npm</NpmCommand>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="$(RepositoryGeneratedFiles)" />
		<Content Remove="$(RepositoryGeneratedFiles)" />
		<None Remove="$(RepositoryGeneratedFiles)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Build inputs and development-only files must not ship in the App Service package. -->
		<Content Update="appsettings.Development.json;audit-ci.json;global.json;lighthouse-report.json;package.json;package-lock.json;vercel.json"
		         CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
		<PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="Dapper" Version="2.1.66" />
		<PackageReference Include="itext7" Version="9.3.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="OpenAI" Version="2.5.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
		<PackageReference Include="PdfPig" Version="0.1.11" />
		<PackageReference Include="StackExchange.Redis" Version="3.0.17" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
		<!-- Explicit patched pins override older Azure SDK transitives. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
		<!-- Explicit current pin overrides a vulnerable Azure SDK transitive. -->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15">
			<NoWarn>NU1510</NoWarn>
		</PackageReference>
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
		<PackageReference Include="System.Numerics.Tensors" Version="10.0.15" />
	</ItemGroup>

	<Target Name="BuildReactForCombinedPublish"
			AfterTargets="ComputeFilesToPublish"
			Condition="'$(BuildReactOnPublish)' == 'true'">
		<Message Importance="high" Text="Building the React BFF frontend for the combined Azure App Service artifact." />
		<Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="$(NpmCommand) ci --no-audit --no-fund" />
		<Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="$(NpmCommand) run build:appservice" />
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\dist\index.html')"
			   Text="The React build did not produce dist/index.html." />
		<ItemGroup>
			<ReactDistFiles Include="$(MSBuildProjectDirectory)\dist\**\*" />
			<ResolvedFileToPublish Include="@(ReactDistFiles->'%(FullPath)')"
			                       Exclude="@(ResolvedFileToPublish)">
				<RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
