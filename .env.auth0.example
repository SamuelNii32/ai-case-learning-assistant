# Auth0 remains inactive until this is explicitly changed to true.
AUTH0_ENABLED=false

# Separately opts the BFF cookie into CasePilot API authorization.
AUTH0_BFF_API_ENABLED=false

# New identities may self-register only as students when explicitly enabled.
AUTH0_STUDENT_REGISTRATION_ENABLED=false

# Existing-account linking additionally requires a valid legacy Bearer login.
AUTH0_EXISTING_ACCOUNT_LINKING_ENABLED=false

# Copy these public identifiers from an Auth0 Regular Web Application.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=

# Keep the real secret only in .NET user-secrets or the deployment platform.
AUTH0_CLIENT_SECRET=

# These paths are handled by the production-capable BFF OpenID Connect handlers.
AUTH0_CALLBACK_PATH=/signin-auth0
AUTH0_SIGNED_OUT_CALLBACK_PATH=/signout-callback-auth0

# This must be the origin visible in the browser, not a separately hosted API origin.
BFF_PUBLIC_ORIGIN=https://localhost:7002

# Production: persistent, access-controlled key-ring directory shared by all instances.
# Prefer Azure Blob + Key Vault before scaling out; a local path is not multi-instance safe.
DATA_PROTECTION_KEYS_PATH=

# Production uses managed identity and requires both values. The Key Vault URI
# must be versionless so old Data Protection keys remain decryptable after rotation.
DATA_PROTECTION_BLOB_URI=
DATA_PROTECTION_KEY_VAULT_KEY_ID=
AZURE_CLIENT_ID=
