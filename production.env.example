# Runtime
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false

# Auth0 Regular Web Application / BFF
AUTH0_ENABLED=true
AUTH0_BFF_API_ENABLED=true
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_PATH=/signin-auth0
AUTH0_SIGNED_OUT_CALLBACK_PATH=/signout-callback-auth0
BFF_PUBLIC_ORIGIN=
AUTH0_STUDENT_REGISTRATION_ENABLED=false
AUTH0_EXISTING_ACCOUNT_LINKING_ENABLED=false

# Shared encrypted ASP.NET Core Data Protection key ring (managed identity)
DATA_PROTECTION_BLOB_URI=
DATA_PROTECTION_KEY_VAULT_KEY_ID=
# Set only for a user-assigned identity. Leave empty for system-assigned identity.
AZURE_CLIENT_ID=

# Legacy JWT rollback. Keep configured until the rollback window closes.
JWT_SECRET=
JWT_ISSUER=IngestionApi
JWT_AUDIENCE=IngestionClient

# Shared application state: API and worker must use identical values.
DATABASE_PROVIDER=postgres
POSTGRES_CONNECTION_STRING=
DOCUMENT_STORAGE_PROVIDER=azureblob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# Web role
RUN_BACKGROUND_WORKER=false
REDIS_CONNECTION_STRING=
TRUST_FORWARDED_HEADERS=true
AZURE_FRONT_DOOR_ID=

# AI and observability
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=

# Capacity and safety limits
MAX_UPLOAD_BYTES=
MAX_UPLOAD_PAGES=
ENABLE_DEBUG_ENDPOINTS=false

# Worker role uses the same database/blob/AI configuration and starts with --worker.
