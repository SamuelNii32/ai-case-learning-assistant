# Development-only. Leave false (or omit it) to retain legacy JWT authentication.
VITE_AUTH0_BFF_ENABLED=false
# Production requires this explicit opt-in. Omit it during development if the
# legacy development flag above is used.
VITE_AUTH_MODE=jwt

# Local ASP.NET Core HTTPS launch profile. This is not an Auth0 secret.
VITE_BFF_PROXY_TARGET=https://localhost:7002
